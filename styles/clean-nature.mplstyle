# sciplot theme=clean target=nature (generated; see scripts/sciplot/styles.py)
figure.facecolor: FFFFFF
savefig.facecolor: FFFFFF
axes.facecolor: FFFFFF
figure.dpi: 150
savefig.dpi: 600
savefig.transparent: False
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.02
figure.constrained_layout.w_pad: 0.02
font.family: sans-serif
font.sans-serif: Inter, Helvetica Neue, Helvetica, Arial, Liberation Sans, DejaVu Sans
font.monospace: JetBrains Mono, IBM Plex Mono, Geist Mono, DejaVu Sans Mono
font.size: 7.0
text.color: 1F2328
axes.labelsize: 7.0
axes.titlesize: 7
axes.titleweight: medium
axes.titlelocation: left
axes.titlepad: 4.0
axes.titlecolor: 1F2328
axes.labelcolor: 1F2328
axes.labelpad: 2.5
axes.labelweight: normal
xtick.labelsize: 6.0
ytick.labelsize: 6.0
xtick.color: 3D434B
ytick.color: 3D434B
xtick.labelcolor: 3D434B
ytick.labelcolor: 3D434B
legend.fontsize: 6.0
legend.title_fontsize: 7.0
figure.titlesize: 9.0
figure.titleweight: bold
mathtext.fontset: custom
mathtext.rm: Inter
mathtext.it: Inter:italic
mathtext.bf: Inter:bold
mathtext.sf: Inter
mathtext.cal: Inter
mathtext.tt: DejaVu Sans Mono
mathtext.default: regular
axes.formatter.use_mathtext: False
axes.unicode_minus: True
axes.formatter.limits: -3, 4
axes.linewidth: 0.6
axes.edgecolor: 3D434B
axes.spines.top: False
axes.spines.right: False
axes.spines.left: True
axes.spines.bottom: True
xtick.direction: out
ytick.direction: out
xtick.major.size: 2.5
ytick.major.size: 2.5
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.size: 1.5
ytick.minor.size: 1.5
xtick.minor.width: 0.48
ytick.minor.width: 0.48
xtick.major.pad: 2.0
ytick.major.pad: 2.0
xtick.minor.visible: False
ytick.minor.visible: False
axes.xmargin: 0.02
axes.ymargin: 0.04
axes.autolimit_mode: data
axes.axisbelow: True
lines.linewidth: 1.0
lines.markersize: 3.5
lines.markeredgewidth: 0.6
lines.solid_capstyle: round
lines.dash_capstyle: round
lines.dashed_pattern: 3.2, 1.8
patch.linewidth: 0.6
patch.edgecolor: 1F2328
patch.force_edgecolor: False
hatch.linewidth: 0.48
scatter.edgecolors: none
errorbar.capsize: 0
boxplot.flierprops.markersize: 2
image.cmap: viridis
image.interpolation: nearest
axes.prop_cycle: cycler('color', ['2270CA', 'DB7F3F', '319C7C', 'C8475B', '7B578E', 'E1B50B', '57B5D9'])
legend.frameon: False
legend.handlelength: 1.4
legend.handletextpad: 0.5
legend.borderaxespad: 0.3
legend.labelspacing: 0.35
legend.columnspacing: 1.0
legend.markerscale: 1.0
legend.labelcolor: 1F2328
axes.grid: False
grid.linewidth: 0.48
grid.color: E6E8EB
grid.linestyle: -
grid.alpha: 1.0
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
path.simplify: True
